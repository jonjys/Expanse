{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "expanse-inky.vercel.app"
        }
      ],
      "destination": "https://expanse.nyttolabs.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/p?slug=:slug"
    }
  ],
  "functions": {
    "api/p.js": {
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
