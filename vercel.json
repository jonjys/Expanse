{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "expanse-inky.vercel.app"
        }
      ],
      "destination": "https://expanse.nyttolabs.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source": "/add", "destination": "/index.html"},
    {"source": "/browse", "destination": "/api/browse"},
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/p?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "functions": {
    "api/p.js": {
      "includeFiles": "index.html"
    },
    "api/browse.js": {
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {"source": "/add", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://gjmkhnrgznorxxaemsmo.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://*.stripe.com; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
