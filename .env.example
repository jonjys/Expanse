# Configuration template only. Never commit real credentials.
# Payment fulfillment: set these only in Vercel Production, not Preview.
# Stripe endpoint signing secret.
STRIPE_WEBHOOK_SECRET=
# Independent random 256-bit credential; store only its SHA-256 in the database.
EXPANSE_PAYMENT_CALLBACK_TOKEN=
# Optional: defaults to the existing Nytto Labs Stripe account.
# STRIPE_ACCOUNT_ID=

# Optional Claude assistance: both credentials below are required to enable it.
# Keep the quota credential independent from payment and owner credentials.
# ANTHROPIC_SECRET_KEY=
# EXPANSE_AI_TOKEN=
# Alternative provider-key name; use one provider-key name, not both.
# ANTHROPIC_API_KEY=
# Optional model override; otherwise the pinned model in the code applies.
# ANTHROPIC_MODEL=
